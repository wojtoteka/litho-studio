{
  "name": "litho-studio",
  "productName": "Litho Studio",
  "version": "1.0.6",
  "description": "Visual website editor that edits real HTML/CSS/JS files on disk - no project format, no export step.",
  "author": {
    "name": "Litho Studio",
    "email": "hello@lithostudio.app"
  },
  "license": "MIT",
  "homepage": "https://wojtoteka.ovh",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "version:set": "node scripts/set-version.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "icons:ui": "node scripts/generate-material-icons.mjs",
    "installer:art": "node scripts/generate-installer-art.mjs",
    "verify:installer": "node scripts/verify-installer.mjs",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && node scripts/package-win.mjs",
    "package:linux": "npm run build && node scripts/package-linux.mjs",
    "package:linux:appimage": "npm run build && node scripts/package-linux.mjs --target=appimage",
    "package:linux:deb": "npm run build && electron-builder --linux deb --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^3.6.0",
    "electron-log": "^5.2.0",
    "node-pty": "^1.1.0",
    "prettier": "^3.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "parse5": "^7.2.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  }
}
